# Copy to .env and fill in what you use. Everything is optional: channels without
# credentials run in sandbox mode, where sends and replies are recorded but not sent.

PORT=3000
# HOST=0.0.0.0              # listen on all interfaces (default 127.0.0.1)
# The address people and networks use to reach this server. Must be https for
# Instagram, Facebook, Threads and TikTok to fetch your media, and for OAuth redirects.
PUBLIC_URL=http://localhost:3000
# DATA_DIR=./data           # database, uploaded media and the encryption key
# POSTBOARD_SECRET=         # encrypts channel tokens; defaults to a key in DATA_DIR

# X (OAuth 2.0 app with tweet.write and dm.write; DMs need a paid API tier)
X_CLIENT_ID=
X_CLIENT_SECRET=

# Meta: one app covers Facebook Pages, Instagram and Messenger
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=          # any string; enter the same one in the Meta webhook settings
# META_PAGE_ID=             # pick a Page when your login manages several
# META_GRAPH_VERSION=v23.0

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_ORG_ID=          # post as a company Page instead of a member
# LINKEDIN_VERSION=         # e.g. 202608; defaults to two months back

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE   # unaudited apps can only post SELF_ONLY

THREADS_APP_ID=
THREADS_APP_SECRET=

GOOGLE_CLIENT_ID=           # YouTube Data API v3
GOOGLE_CLIENT_SECRET=
# YOUTUBE_PRIVACY=public

# Discord: the webhook and bot token can also be entered in Channels
# DISCORD_BOT_TOKEN=

# SCHEDULER_SECONDS=15
# INBOX_POLL_SECONDS=120
